 "harness": "OpenCode",
 "harness_version": "1.19.5",
 "writer_model": "openai/gpt-6.1-sol",
 "explorer_baseline_model": "openai/gpt-6.1-sol",
 "jev_model": "typesafe/jev-1.14",
 "conditions": [
  "native",
  "jev",
  "search",
  "oracle"
 ],
 "intervention": "Replace only the native explore subagent model response with Jev ranking deterministic file candidates. Writer, tools, issue, and budget stay fixed.",
 "candidate_files": 12,
 "selected_files": 3,
 "snippet_chars_per_file": 1800,
 "confidence_policy": "Select three highest finite Noul relevance scores. This is a ranking experiment; no calibrated acceptance claim. On decision API or validation error, use the native explorer and charge both costs.",
 "main_steps": 16,
 "explore_steps": 6,
 "max_requests": 32,
 "max_output_tokens": 4096,
 "max_input_bytes": 196608,
 "timeout_s": 480,
 "task_budget_usd": 2,
 "experiment_budget_usd": 25,
 "evaluation": "Apply official test_patch only in evaluator copy, run published FAIL_TO_PASS and PASS_TO_PASS nodes under local pytest. Validate broken-base fails and gold patch passes. Not official Docker SWE-bench.",
 "dependencies": [
  "pytest==7.4.4",
  "setuptools==70.3.0",
  "numpy==1.26.4",
  "pillow==11.3.0"
 ],
 "future_direction": "Original BANKING77/CLINC150 intent decisions with tool-using escalation, deferred until the coding-harness experiment is established.",
 "environment_notes": "pytest 7 retains historical nose-style setup; setuptools supplies pkg_resources. Truncated upstream parameter IDs expand to the whole parent test function, adding regression cases rather than dropping them.",
 "owner": "Omar (branch omar)",
 "extends": "internal-explore-v1 (coding_protocol.json). Harness, writer, Jev model, retrieval (12 candidates, 3 selected), step/token/time limits and evaluator are unchanged. Changes: more tasks, an oracle condition, a larger budget, per-phase timing, and invalid environments are dropped and recorded instead of stopping the study.",
 "data_url": "https://datasets-server.huggingface.co/rows?dataset=princeton-nlp%2FSWE-bench&config=default&split=dev&offset={offset}&length=100",
 "oracle": "Upper-bound reference, not a deployable method: the explorer returns the implementation files under pydicom/ that the instance's gold patch modifies and that exist at the base commit, each with the same query-matched 16-line snippet as other conditions. Only file paths are revealed; the gold patch content, test patch and expected outcomes stay outside the agent workspace.",
 "lanes": 4,
 "lane_assignment": "Tasks are assigned to lanes round-robin in instance order; each lane runs its tasks one at a time and all four conditions of a task consecutively, in a per-task order shuffled with seed 329, so that load and time of day affect every condition equally. Each lane has its own ledger capped at experiment_budget_usd / lanes.",
 "invalid_environments": "check() records every task whose broken base does not fail or whose gold patch does not pass; such tasks are dropped from the primary analysis and reported, never run.",
 "timing": "Primary outcome alongside repair success and cost: agent wall time per run (OpenCode start to exit), time in exploration (retrieval plus Jev decision, or the native explorer's model calls), time in writer model calls, and evaluation time, recorded in result.json.",
 "cache_dir": ".runtime/coding-v2",
 "runs_dir": "runs/coding-v2"
}
